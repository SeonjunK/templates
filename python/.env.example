# Copy this file to .env and fill in the values.
# Format: APP__<SECTION>__<FIELD>=<value>
# env_prefix="APP__", env_nested_delimiter="__"

# Application
APP__APP__NAME=my-app
APP__APP__ENV=production
APP__APP__DEBUG=false
APP__APP__LOG_LEVEL=INFO

# Server
APP__SERVER__HOST=0.0.0.0
APP__SERVER__PORT=8000
APP__SERVER__WORKERS=4
APP__SERVER__RELOAD=false

# Database
APP__DATABASE__URL=postgresql://user:password@localhost/dbname
APP__DATABASE__POOL_SIZE=10
APP__DATABASE__MAX_OVERFLOW=20
APP__DATABASE__ECHO=false

# Auth — SENSITIVE: never commit real values to version control
APP__AUTH__SECRET_KEY=your-secret-key-here
APP__AUTH__ALGORITHM=HS256
APP__AUTH__EXPIRE_MINUTES=60

# OpenTelemetry (optional — omit to use local console output only)
# APP__OTEL__ENDPOINT=http://localhost:4318          # Jaeger / Grafana Tempo / etc.
# APP__OTEL__HEADERS='{"X-Tenant-ID": "my-tenant"}' # non-sensitive headers
# APP__OTEL__SECRET_HEADERS='{"Authorization": "Bearer <token>"}' # sensitive headers — values masked in logs
# APP__OTEL__SEND_TO_LOGFIRE=false
